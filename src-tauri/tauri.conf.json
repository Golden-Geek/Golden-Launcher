{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Golden Launcher",
  "version": "0.1.3",
  "identifier": "com.goldengeek.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Golden Launcher",
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 580,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#090909"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Install, update, and open Golden apps",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNzBENzEwNTVFRkVFQkMKUldTODd1OVZFTmR3N0RQMDFlaFk3MzV0Qzg0Tmh6ZEFhbE1PYWNuNHVQQmEvRGwvZndMOUZaWG8K",
      "endpoints": ["https://github.com/Golden-Geek/Golden-Launcher/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
